# Nombre de la aplicacion (se muestra en la UI y en los metadatos)
NEXT_PUBLIC_APP_NAME=jhotziry

# URL publica de la app (usada para construir el enlace del magic link)
APP_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/jhotziry

# Secreto para firmar/derivar tokens de sesion y magic links
AUTH_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# SMTP para el magic link
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@dominio.com
SMTP_PASS=tu-contraseña-smtp
MAIL_FROM="jhotziry <tu-correo@dominio.com>"

# Proveedor de IA 3D: "tripo" (real) o "mock" (por defecto, sin coste)
AI_PROVIDER=tripo

# Capa de IA creativa con DeepSeek (enriquece prompts de texto y analiza imagenes).
# Sin DEEPSEEK_API_KEY el flujo funciona igual usando el prompt original.
AI_ENHANCE=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Tripo3D V3 (genera imagenes y modelos)
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL=v3.1-20260211
TRIPO_FACE_LIMIT=80000
TRIPO_TEXTURE=true
TRIPO_PBR=true

# Creditos
WELCOME_CREDITS=10
CREDITS_PER_PREVIEW=5

# Correos que se vuelven administradores automaticamente al entrar (separados por coma)
ADMIN_EMAILS=

# Carpeta local para guardar los archivos en desarrollo
STORAGE_DIR=./.data
